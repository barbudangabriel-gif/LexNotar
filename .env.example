# Production environment variables for Docker
# Copy this file to .env and fill in your values

# Database
POSTGRES_PASSWORD=your_secure_database_password_here

# JWT Secrets (MUST CHANGE IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-here-change-me
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-characters-here-change-me

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=LexNotar <noreply@lexnotar.ro>

# Frontend API URL (for production)
VITE_API_BASE_URL=https://api.yourdomain.com

# Optional: Redis connection (if using Redis)
REDIS_HOST=redis
REDIS_PORT=6379
